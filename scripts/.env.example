# Copy to scripts/.env (git-ignored) and fill in.
# Any OpenAI-compatible LLM gateway that exposes OpenAI routes under <base>/openai/v1/...
LLM_GATEWAY_BASE=https://your-gateway.example.com
LLM_GATEWAY_TOKEN=
# Optional: appended to the bearer token as "<token>:<project>" (set empty to disable)
# LLM_GATEWAY_PROJECT=wa-virtmic
# Optional overrides
# REALTIME_MODEL=gpt-realtime
# REALTIME_VOICE=marin
# LLM_GATEWAY_TTS_MODEL=gpt-4o-mini-tts
