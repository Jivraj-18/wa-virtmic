<mxfile host="drawio"><diagram id="arch" name="How it works"><mxGraphModel dx="1700" dy="1040" grid="0" gridSize="10" guides="1" page="1" pageWidth="1700" pageHeight="1040" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="How the AI voice gets onto a WhatsApp call (and into Google Meet)" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontSize=24;fontColor=#1d1d1f;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Follow the numbers 1 to 8. Line colour tells you what kind of connection it is (key at the bottom)." style="rounded=1;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontSize=14;fontColor=#5f6368;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1200" height="26" as="geometry"/></mxCell><mxCell id="c4" value="OUT IN THE WORLD" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#f5f5f5;strokeColor=#d0d0d0;fontSize=14;fontColor=#616161;align=center;verticalAlign=top;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="290" height="860" as="geometry"/></mxCell><mxCell id="c5" value="GITHUB CODESPACE  (a Linux computer in the cloud; all our code runs here)" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#eef4ff;strokeColor=#b8cdf5;fontSize=14;fontColor=#1a4fa0;align=center;verticalAlign=top;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="780" height="860" as="geometry"/></mxCell><mxCell id="c6" value="CLOUD AI SERVICES" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#fff5e8;strokeColor=#f3d1a6;fontSize=14;fontColor=#a34a00;align=center;verticalAlign=top;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1150" y="90" width="530" height="860" as="geometry"/></mxCell><mxCell id="c7" value="Caller's phone&#xa;any normal WhatsApp user" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=14;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="230" height="80" as="geometry"/></mxCell><mxCell id="c8" value="People in a Google Meet" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=14;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="230" height="60" as="geometry"/></mxCell><mxCell id="c9" value="You, in any browser&#xa;watch the Chrome window,&#xa;scan the WhatsApp QR once" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=13;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="820" width="230" height="90" as="geometry"/></mxCell><mxCell id="c10" value="Chrome browser  (real, visible window; not headless)" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#ffffff;strokeColor=#1565c0;fontSize=13;fontColor=#1565c0;align=center;verticalAlign=top;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="140" width="360" height="270" as="geometry"/></mxCell><mxCell id="c11" value="Tab: web.whatsapp.com&#xa;receives WhatsApp calls" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#e8f5e9;strokeColor=#66bb6a;fontSize=13;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="190" width="310" height="80" as="geometry"/></mxCell><mxCell id="c12" value="Tab: meet.google.com&#xa;'Maya' joins meetings" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#e8f5e9;strokeColor=#66bb6a;fontSize=13;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="300" width="310" height="80" as="geometry"/></mxCell><mxCell id="c13" value="Playwright (Python)  =  'robot hands' for Chrome&#xa;talks to Chrome over CDP (Chrome DevTools&#xa;Protocol), a local connection on port 9222&#xa;&#xa;- WhatsApp: checks the page every 0.5 s for an&#xa;  Accept button, clicks it, notices when call ends&#xa;- Meet: clicks Join, turns on captions, reads&#xa;  captions (who said what) + chat, types tips" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#ffffff;strokeColor=#1565c0;fontSize=12;fontColor=#1d1d1f;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="140" width="320" height="190" as="geometry"/></mxCell><mxCell id="c14" value="PulseAudio  =  fake audio devices" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=13;fontColor=#2e7d32;align=center;verticalAlign=top;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="470" width="360" height="250" as="geometry"/></mxCell><mxCell id="c15" value="'callout_sink' = Chrome's SPEAKER&#xa;the other person's voice lands here" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#e8f5e9;strokeColor=#66bb6a;fontSize=12;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="515" width="310" height="70" as="geometry"/></mxCell><mxCell id="c16" value="'virtmic' = Chrome's MICROPHONE&#xa;whatever we play here, they hear" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#e8f5e9;strokeColor=#66bb6a;fontSize=12;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="625" width="310" height="70" as="geometry"/></mxCell><mxCell id="c17" value="Voice bridge  (realtime_agent.py)&#xa;&#xa;records both sides of the call,&#xa;sends the caller's voice to the AI,&#xa;plays the AI's voice into the fake mic,&#xa;cuts the AI off if the caller interrupts" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#f6edfa;strokeColor=#7b1fa2;fontSize=12;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="470" width="320" height="165" as="geometry"/></mxCell><mxCell id="c18" value="Add-ons from the experiments&#xa;&#xa;E0  fake caller, to test without a phone&#xa;E1  'call center' folder: instructions + notes&#xa;E2  look things up mid-call (file search,&#xa;       Claude Code in the background)&#xa;E4  Maya: speaks only when her name is said&#xa;E5  plays audio files / a generated podcast" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=12;fontColor=#1d1d1f;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="690" width="320" height="190" as="geometry"/></mxCell><mxCell id="c19" value="noVNC: shows the Chrome window&#xa;on a web page" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=12;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="830" width="310" height="70" as="geometry"/></mxCell><mxCell id="c20" value="Company LLM gateway&#xa;&#xa;ordinary HTTPS requests only&#xa;CANNOT carry a WebSocket,&#xa;so it only hands out a temporary&#xa;OpenAI key for each call" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#ffffff;strokeColor=#e65100;fontSize=13;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="140" width="370" height="175" as="geometry"/></mxCell><mxCell id="c21" value="OpenAI Realtime API&#xa;api.openai.com,  model: gpt-realtime&#xa;&#xa;one model that listens AND speaks&#xa;(no separate speech-to-text / text-to-speech)&#xa;live both ways: caller audio in, AI voice out&#xa;replies about 1.3 s after the caller stops" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#f6edfa;strokeColor=#7b1fa2;fontSize=13;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="450" width="370" height="175" as="geometry"/></mxCell><mxCell id="c22" value="Other models, also through the gateway (HTTPS)&#xa;&#xa;gpt-4.1-mini: call summaries, Maya's chat tips,&#xa;                    podcast scripts&#xa;gpt-4o-mini-tts: podcast voices" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#ffffff;strokeColor=#e65100;fontSize=12;fontColor=#1d1d1f;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="720" width="370" height="140" as="geometry"/></mxCell><mxCell id="c23" value="1  WhatsApp call&#xa;(WebRTC, encrypted)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#2e7d32;strokeWidth=3;dashed=0;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="Meet call (WebRTC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#2e7d32;strokeWidth=3;dashed=0;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="2  CDP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#1565c0;strokeWidth=2;dashed=1;fontSize=12;fontColor=#1565c0;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0;exitY=0.32;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="3  call audio out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#2e7d32;strokeWidth=3;dashed=0;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.22;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset"/></mxGeometry></mxCell><mxCell id="c27" value="4  caller's voice&#xa;(raw audio)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#2e7d32;strokeWidth=3;dashed=0;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#e65100;strokeWidth=2;dashed=0;fontSize=12;fontColor=#e65100;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1272" y="495"/><mxPoint x="1272" y="271"/></Array></mxGeometry></mxCell><mxCell id="c29" value="5  HTTPS request:&#xa;'give me a temporary&#xa;OpenAI key' (once per call)" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontSize=12;fontColor=#e65100;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1092" y="330" width="178" height="60" as="geometry"/></mxCell><mxCell id="c30" value="gateway gets the key&#xa;from OpenAI (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#e65100;strokeWidth=2;dashed=1;fontSize=12;fontColor=#e65100;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#7b1fa2;strokeWidth=4;dashed=0;fontSize=12;fontColor=#7b1fa2;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="6  WebSocket opened&#xa;DIRECTLY to OpenAI&#xa;with that key&#xa;(NOT through the gateway)" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontSize=12;fontColor=#7b1fa2;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="585" width="190" height="75" as="geometry"/></mxCell><mxCell id="c33" value="7  AI voice&#xa;(raw audio)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#2e7d32;strokeWidth=3;dashed=0;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="8  'mic' audio goes&#xa;into the call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#2e7d32;strokeWidth=3;dashed=0;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="352" y="660"/><mxPoint x="352" y="370"/></Array></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#1565c0;strokeWidth=2;dashed=1;fontSize=12;fontColor=#1565c0;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#e65100;strokeWidth=2;dashed=0;fontSize=12;fontColor=#e65100;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="plug into" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#757575;strokeWidth=2;dashed=1;fontSize=12;fontColor=#757575;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="web page&#xa;(HTTPS, port 6080)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#757575;strokeWidth=2;dashed=1;fontSize=12;fontColor=#757575;labelBackgroundColor=#ffffff;fontStyle=1;fontFamily=Helvetica;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#ffffff;strokeColor=#d0d0d0;fontSize=13;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="965" width="1660" height="60" as="geometry"/></mxCell><mxCell id="c40" value="KEY" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontSize=13;fontColor=#1d1d1f;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="975" width="60" height="40" as="geometry"/></mxCell><mxCell id="c41" value="" style="rounded=0;whiteSpace=nowrap;html=0;fillColor=#2e7d32;strokeColor=#2e7d32;fontSize=13;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="110" y="992" width="46" height="4" as="geometry"/></mxCell><mxCell id="c42" value="live call audio" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontSize=13;fontColor=#2e7d32;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="165" y="978" width="250" height="32" as="geometry"/></mxCell><mxCell id="c43" value="" style="rounded=0;whiteSpace=nowrap;html=0;fillColor=#7b1fa2;strokeColor=#7b1fa2;fontSize=13;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="425" y="992" width="46" height="4" as="geometry"/></mxCell><mxCell id="c44" value="live stream to the AI (WebSocket)" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontSize=13;fontColor=#7b1fa2;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="978" width="250" height="32" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=0;whiteSpace=nowrap;html=0;fillColor=#e65100;strokeColor=#e65100;fontSize=13;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="992" width="46" height="4" as="geometry"/></mxCell><mxCell id="c46" value="one-off HTTPS request" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontSize=13;fontColor=#e65100;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="795" y="978" width="250" height="32" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=0;whiteSpace=nowrap;html=0;fillColor=#1565c0;strokeColor=#1565c0;fontSize=13;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1055" y="992" width="46" height="4" as="geometry"/></mxCell><mxCell id="c48" value="Chrome being controlled (CDP)" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontSize=13;fontColor=#1565c0;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="978" width="250" height="32" as="geometry"/></mxCell><mxCell id="c49" value="" style="rounded=0;whiteSpace=nowrap;html=0;fillColor=#757575;strokeColor=#757575;fontSize=13;fontColor=#1d1d1f;align=center;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="992" width="46" height="4" as="geometry"/></mxCell><mxCell id="c50" value="other" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontSize=13;fontColor=#757575;align=left;verticalAlign=middle;spacing=10;arcSize=8;dashed=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1425" y="978" width="250" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>